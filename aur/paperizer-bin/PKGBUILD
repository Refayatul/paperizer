# Maintainer: Refayatul <https://github.com/Refayatul>
# Contributor: Humanitas Labs (Paperize core)

pkgname=paperizer-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="A quiet, native PDF reader & warm paper styler for Linux"
arch=('any')
url="https://github.com/Refayatul/paperizer"
license=('MIT')
depends=(
    'python>=3.11'
    'pyside6'
    'python-pikepdf'
    'python-pymupdf'
)
makedepends=(
    'python-installer'
)
provides=('paperizer' 'paperize-gui')
conflicts=('paperizer-git' 'paperize-gui')
source=(
    "https://github.com/Refayatul/paperizer/releases/download/v${pkgver}/${pkgname}-${pkgver}-py3-none-any.whl"
    "https://raw.githubusercontent.com/Refayatul/paperizer/v${pkgver}/paperizer.desktop"
    "https://raw.githubusercontent.com/Refayatul/paperizer/v${pkgver}/assets/icon.svg"
    "https://raw.githubusercontent.com/Refayatul/paperizer/v${pkgver}/LICENSE"
)
sha256sums=(
    '2ab9bae76fcaf044a6608015760f9e7f9872f0b3c2b739a9798391097ab843f5'
    'c033818bd6f2258dde9ac6dc8ec8554214cc7df53ec32fdf488f4742ca2aafba'
    '08f4aa4c0960bafb3481a56f034872808ef337c241fb6d9ae2a2a2861375a363'
    'eab257ca89e04dfdad0aaa676e0e3ce7abb52cee6d318ef3b2cb4c1d1f877ffd'
)

package() {
    python -m installer --destdir="${pkgdir}" "${srcdir}/${pkgname}-${pkgver}-py3-none-any.whl"

    install -Dm644 "${srcdir}/paperizer.desktop" "${pkgdir}/usr/share/applications/paperizer.desktop"
    install -Dm644 "${srcdir}/icon.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/paperizer.svg"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
